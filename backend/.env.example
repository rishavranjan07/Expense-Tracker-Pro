PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/expense_tracker_pro?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d
